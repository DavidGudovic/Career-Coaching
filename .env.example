# Copy to .env and fill in. Generate a secret with: openssl rand -hex 32
DATABASE_URI=postgres://karijera:karijera@localhost:5432/karijera
PAYLOAD_SECRET=change-me-openssl-rand-hex-32
NEXT_PUBLIC_SERVER_URL=https://jelena.rajkovic.coach
MEDIA_DIR=media

# Contact form -> Jelena's inbox (e.g. Brevo/Resend SMTP, or Gmail app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@jelena.rajkovic.coach

# Optional: prevent automatic schema changes when testing against a database copy.
# PAYLOAD_SCHEMA_PUSH=false

# Optional self-hosted Umami analytics (see docs/seo-analytics.md).
ANALYTICS_ENABLED=false
ANALYTICS_TRUST_PROXY=false
UMAMI_URL=http://umami:3000
UMAMI_WEBSITE_ID=
UMAMI_USERNAME=
UMAMI_PASSWORD=
# Enable only after filling the three independent random secrets below:
# COMPOSE_PROFILES=analytics
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
UMAMI_TWO_FACTOR_KEY=
